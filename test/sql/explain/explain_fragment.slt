query I
explain SELECT count(*) FROM t;
----
PROJECT (4)
 - table index: #4
 - expressions: [count(star) (#0)]
-> AGGREGATE (3)
   - aggregate table index: #3
   - aggregate: [COUNT(__rowid (#0))]
  -> TABLE SCAN (2)
     - table name: t(default_db.t)
     - table index: #1
     - output_columns: [__rowid]

query I
explain SELECT count(*) FROM t WHERE a > 1;
----
PROJECT (5)
 - table index: #4
 - expressions: [count(star) (#0)]
-> AGGREGATE (4)
   - aggregate table index: #3
   - aggregate: [COUNT(__rowid (#1))]
  -> FILTER (3)
     - filter: CAST(a (#0) AS BigInt) > 1
     - output columns: [a, __rowid]
    -> TABLE SCAN (2)
       - table name: t(default_db.t)
       - table index: #1
       - output_columns: [a, __rowid]

