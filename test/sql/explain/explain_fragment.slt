# name: test/sql/explain/explain_fragment.slt
# description: EXPLAIN FRAGMENT / physical plans, pinned to the reference output
# group: [explain]

statement ok
CREATE TABLE t (a INT, b VARCHAR, c INT);

statement ok
INSERT INTO t VALUES (1,'x',10),(2,'y',20),(3,'x',30);

query I
explain SELECT * FROM t;
----
PROJECT (3)
 - table index: #4
 - expressions: [a (#0), b (#1), c (#2)]
-> TABLE SCAN (2)
   - table name: t(default_db.t)
   - table index: #1
   - output_columns: [a, b, c, __rowid]

query I
explain SELECT a FROM t WHERE b = 'x';
----
PROJECT (4)
 - table index: #4
 - expressions: [a (#1)]
-> FILTER (3)
   - filter: b (#0) = x
   - output columns: [b, __rowid]
  -> TABLE SCAN (2)
     - table name: t(default_db.t)
     - table index: #1
     - output_columns: [b, __rowid]

query I
explain SELECT a FROM t ORDER BY a;
----
PROJECT (4)
 - table index: #4
 - expressions: [a (#0)]
-> SORT (3)
   - expressions: [a (#0) ASC]
   - output columns: [a, __rowid]
  -> TABLE SCAN (2)
     - table name: t(default_db.t)
     - table index: #1
     - output_columns: [a, __rowid]

